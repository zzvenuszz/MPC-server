# MCP Programming Support Server - Cấu hình Môi trường
# Sao chép file này thành .env và điền giá trị thực tế

# =============================================================================
# CẤU HÌNH CHUNG
# =============================================================================

# Thư mục làm việc (workspace) - nơi lưu trữ file dự án
WORKSPACE=/data

# Mức độ log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Timeout cho các request HTTP (giây)
REQUEST_TIMEOUT=30

# Kích thước file tối đa được phép đọc/ghi (bytes)
MAX_FILE_SIZE=10485760

# Port cho MCP Server (HF Spaces dùng 8080 - đã cấu hình trong README.md app_port: 8080)
# FastMCP SSE transport sẽ đọc port từ biến môi trường này
PORT=8080

# =============================================================================
# BẢO MẬT & QUYỀN HẠN
# =============================================================================

# Cho phép thực thi shell commands (true/false)
ALLOW_SHELL=true

# Cho phép ghi file (true/false)
ALLOW_WRITE=true

# Danh sách shell commands được phép (phân cách bằng dấu phẩy)
# Nếu để trống, sử dụng danh sách mặc định an toàn
ALLOWED_SHELL_COMMANDS=git,ls,find,grep,rg,python,node,npm,pip,cargo,go,java,gradle,mvn

# =============================================================================
# GITHUB INTEGRATION
# =============================================================================

# GitHub Personal Access Token (để tìm kiếm repository, code)
# Lấy token tại: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# =============================================================================
# MINECRAFT PAPER SERVER
# =============================================================================

# Đường dẫn đến thư mục mã nguồn Paper server (đã clone)
PAPER_SERVER_PATH=/data/paper-server

# Phiên bản Paper API sử dụng (ví dụ: 1.20, 1.20.1)
PAPER_API_VERSION=1.20

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Đường dẫn thư mục log
LOG_DIR=/app/logs

# Kích thước file log tối đa (bytes) trước khi rotate
LOG_MAX_SIZE=10485760

# Số file log backup giữ lại
LOG_BACKUP_COUNT=5

# =============================================================================
# DOCKER (nếu cần)
# =============================================================================

# Docker socket path (nếu chạy trong container)
DOCKER_SOCKET=/var/run/docker.sock

# =============================================================================
# CULTIVATION GAME DESIGN (XIANXIA)
# =============================================================================

# Ngôn ngữ cho nội dung tu tiên (vi, en, zh)
CULTIVATION_LANGUAGE=vi

# Mức độ chi tiết của nội dung tu tiên (low, medium, high)
CULTIVATION_DETAIL_LEVEL=high

# =============================================================================
# PERFORMANCE & RATE LIMITING
# =============================================================================

# Số request tối đa mỗi phút
RATE_LIMIT_PER_MINUTE=60

# Số concurrent requests tối đa
MAX_CONCURRENT_REQUESTS=10

# =============================================================================
# NETWORK & PROXY (nếu cần)
# =============================================================================

# HTTP Proxy (nếu cần)
HTTP_PROXY=

# HTTPS Proxy (nếu cần)
HTTPS_PROXY=

# Không verify SSL certificates (chỉ dùng cho development)
VERIFY_SSL=true

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server host (HF Spaces cần 0.0.0.0)
HOST=0.0.0.0
